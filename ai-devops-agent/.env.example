# AI DevOps Agent — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# --- Ollama (LLM + Embeddings) ---
OLLAMA_BASE_URL=http://ollama-service.ai-agent.svc.cluster.local:11434
OLLAMA_LLM_MODEL=llama3.1:70b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1

# --- Milvus (Vector Store) ---
# For Mac/local dev without Docker, set MILVUS_LITE_PATH to a .db file path (uses Milvus Lite).
# MILVUS_LITE_PATH=./data/milvus_lite.db
MILVUS_HOST=milvus.ai-agent.svc.cluster.local
MILVUS_PORT=19530
MILVUS_COLLECTION=devops_knowledge

# --- Elasticsearch (EFK Logs) ---
ELASTICSEARCH_URL=https://elasticsearch.monitoring.svc.cluster.local:9200
ELASTICSEARCH_USER=ai_agent_ro
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_CA_CERT=/certs/elastic-ca.crt

# --- Prometheus ---
PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090

# --- ServiceNow (required) ---
SNOW_BASE_URL=https://your-instance.service-now.com
SNOW_USERNAME=svc_ai_agent
SNOW_PASSWORD=CHANGE_ME
SNOW_CA_CERT=/certs/internal-ca.crt
SNOW_POLL_INTERVAL_SECONDS=300
SNOW_ASSIGNMENT_GROUP=DevOps-Team
SNOW_AUTO_CLOSE_PRIORITIES=2,3

# --- SSH ---
SSH_KEY_PATH=/secrets/ai-agent-ssh-key
SSH_USERNAME=ai-agent-svc
SSH_KNOWN_HOSTS=/secrets/known_hosts

# --- Ansible ---
ANSIBLE_PLAYBOOKS_DIR=/opt/ansible-playbooks/approved/
ANSIBLE_INVENTORY_DIR=/etc/ansible/inventory/

# --- Audit & Safety ---
AUDIT_LOG_PATH=/var/log/ai-agent/audit.log
AUTO_FIX_CONFIDENCE_THRESHOLD=80
MAX_AUTO_FIX_ATTEMPTS=2
VERIFY_WAIT_SECONDS=120

# --- Kubernetes ---
K8S_NAMESPACE_PROD=production
# JSON: maps SNOW CI names to K8s labels/deployments
APP_NAME_MAP={"d2":"d2-app","cs":"cs-app","d2config":"d2config","dsearch":"dsearch","ext":"ext"}

# --- Internal API (for admin endpoints) ---
INTERNAL_API_TOKEN=CHANGE_ME
